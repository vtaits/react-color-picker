{
  "type": "module",
  "name": "@vtaits/react-color-picker",
  "version": "2.1.0",
  "description": "React Color Picker",
  "files": [
    "dist",
    "src",
    "style"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./index.css": {
      "import": "./style/index.css"
    }
  },
  "scripts": {
    "start": "storybook dev -p 6006",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepare": "bun run clean && bun run build",
    "lint": "biome check src stories",
    "lint:fix": "biome check src stories --write --unsafe",
    "test:ts": "tsc",
    "test": "bun run lint && bun run test:ts"
  },
  "keywords": [
    "react",
    "react-component",
    "color",
    "picker",
    "color-picker"
  ],
  "dependencies": {
    "@types/tinycolor2": "^1.4.6",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@storybook/react-vite": "^10.6.2",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "react": "^16.3.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.3.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vtaits/react-color-picker.git"
  },
  "bugs": {
    "url": "https://github.com/vtaits/react-color-picker/issues"
  },
  "license": "MIT",
  "author": "Vadim Taits <taizvadim@gmail.com>"
}
